// Test-only snapshot of deployed rules, 2026-09-24. Coach UID replaced.
// Never deploy this fixture: test-coach is a synthetic identity.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /votes/{voteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /responses/{respId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }
    match /ratings/{date} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
      match /votes/{voter} {
        allow read: if isAdmin();
        allow create, update: if false;
        allow delete: if isAdmin();
      }
    }
    match /ratingParticipation/{date}/voters/{name} {
      allow read, write: if false;
    }
    match /ratingResults/{date} {
      allow get: if true;
      allow list, write: if false;
    }
    function positionSurveySignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function positionSurveyCoach() {
      return positionSurveySignedIn() && request.auth.uid == 'test-coach';
    }
    function validPositionPreference() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'first', 'second', 'stable', 'flexible', 'note', 'updatedAt'])
        && d.keys().hasAll(['name', 'first', 'second', 'stable', 'flexible', 'note', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.name.matches('^[^/]+$')
        && exists(/databases/$(database)/documents/players/$(d.name))
        && d.first in ['GK','LB','CB','RB','DM','CM','AM','LW','RW','FW']
        && d.second in ['GK','LB','CB','RB','DM','CM','AM','LW','RW','FW']
        && d.stable is bool && d.flexible is bool
        && d.note is string && d.note.size() <= 500
        && d.updatedAt == request.time;
    }
    match /privatePositionPreferences/{uid} {
      allow get: if positionSurveyCoach()
        || (positionSurveySignedIn() && request.auth.uid == uid);
      allow list: if positionSurveyCoach();
      allow create: if positionSurveySignedIn() && request.auth.uid == uid
        && validPositionPreference();
      allow update: if positionSurveySignedIn() && request.auth.uid == uid
        && request.resource.data.name == resource.data.name
        && validPositionPreference();
      allow delete: if false;
    }
    match /{collectionName}/{docId} {
      allow read: if collectionName != 'admins'
        && collectionName != 'ratings'
        && collectionName != 'ratingResults'
        && collectionName != 'ratingParticipation'
        && collectionName != 'privatePositionPreferences';
      allow write: if collectionName != 'admins'
        && collectionName != 'ratings'
        && collectionName != 'ratingResults'
        && collectionName != 'ratingParticipation'
        && collectionName != 'privatePositionPreferences'
        && isAdmin();
    }
  }
}
